{
  "name": "duolinext",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors green,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "setup": "python -m pip install -r backend/requirements.txt && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
